use "react";
use "../atoms";
use "../traits";

fn Footer(content: (is component)) is component,
  fromFigma(
    "https://www.figma.com/design/QRrnCVX7stPZ0x1m3zMxr9/Elfie-Design?node-id=114-3133&t=5AeWwpuJzWSP1Pwq-4",
  ) {
  @acceptanceCriteria
    .add({ behavior = `Content of the component is [[content]]` })
    .add({ behavior = `Usese [[Logo]] for the logo` })
    .add({
      behavior = [
        `Documentation link links to /docs`,
        `Tutorials link links to /tutorials`,
        `The Elfie language link links to /`,
        `GitHub link links to https://github.com/elfie-lang/elfie`,
        `Community link links to https://github.com/elfie-lang/elfie`,
        `Download link links to https://github.com/elfie-lang/elfie/releases`,
      ],
    });
}
